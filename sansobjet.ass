; start main program
; Main program
	TSTO #1
	BOV stack_overflow_error
	ADDSP #1
; Variables Declarations 
	LOAD #2, R0
	STORE R0, 1(GB)
; Beginning of main instructions:
	LOAD 1(GB), R2
	FLOAT R2, R1
	LOAD #1, R3
	FLOAT R3, R2
	DIV R2, R1
	WFLOAT
	WNL
	HALT
; Gestion des erreurs
stack_overflow_error:
	WSTR "Error: Stack Overflow"
	WNL
	ERROR
io_error:
	WSTR "Error: Input/Output error"
	WNL
	ERROR
division_by_zero:
	WSTR "Error: Division by zero"
	WNL
	ERROR
; end main program

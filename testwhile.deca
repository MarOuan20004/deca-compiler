// Test de la structure de contrôle 'while'
{
    int i = 0;
    int somme = 0;
    int n = 5;

    println("--- Debut du test While ---");

    // Test d'une boucle simple : calcul de la somme des n premiers entiers
    while (i <= n) {
        println("Iteration ", i);
        somme = somme + i;
        i = i + 1;
    }

    println("Somme calculee (attendue 15) : ", somme);

    // Test d'une boucle qui ne s'execute jamais
    while (false) {
        println("Erreur : Ce message ne doit pas s'afficher");
    }


    i = 10;
    while (i > 0 && somme > 0) {
        somme = somme - i;
        i = i - 2;
    }

    println("Valeur finale de i : ", i);
    println("Test termine avec succes.");
}
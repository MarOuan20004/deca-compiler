//-
// Classe A : classe de base simple
//-
class A {
    protected int field_int_A = 1;
    protected float field_float_A = 1.0;
}

//-
// Classe B : hérite de A
//-
class B extends A {
    protected boolean field_bool_B = true;
}

//-
// Bloc principal
//-
{
    // Déclarations de variables locales
    int local_int = 10;
    float local_float = 20.5;
    boolean local_bool;

    // Instructions simples
    local_int = local_int + 5;
    local_float = local_float / 2.0;
    local_bool = local_int > 12;

    // Structure de contrôle if/else
    if (local_bool) {
        println("local_bool est vrai");
    } else {
        println("local_bool est faux");
    }

    // Boucle while
    while (local_int < 20) {
        println("Dans la boucle, local_int = ", local_int);
        local_int = local_int + 1;
    }

    println("Fin du programme de test.");
}


; start main program
; Main program
	TSTO #6
	BOV stack_overflow_error
	ADDSP #3
; Variables Declarations 
	STORE R0, 1(GB)
	STORE R0, 2(GB)
	STORE R0, 3(GB)
; Beginning of main instructions:
	LOAD #2, R2
	STORE R2, 1(GB)
	LOAD #4, R2
	STORE R2, 2(GB)
	LOAD 1(GB), R2
	LOAD 2(GB), R3
	ADD R3, R2
	LOAD 2(GB), R3
	LOAD #3, R4
	ADD R4, R3
	MUL R3, R2
	STORE R2, 3(GB)
	LOAD 3(GB), R1
	LOAD 1(GB), R2
	ADD R2, R1
	WINT
	WNL
	HALT
; Gestion des erreurs
stack_overflow_error:
	WSTR "Error: Stack Overflow"
	WNL
	ERROR
io_error:
	WSTR "Error: Input/Output error"
	WNL
	ERROR
division_by_zero:
	WSTR "Error: Division by zero"
	WNL
	ERROR
; end main program

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.ensimag</groupId>
    <artifactId>Deca</artifactId>
    <name>Deca Compiler</name>
    <version>0.0.1-SNAPSHOT</version>
    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jacoco.skip>false</jacoco.skip>
        <jacoco.report_dir>${project.build.directory}/site/jacoco</jacoco.report_dir>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.antlr</groupId>
            <artifactId>antlr4-runtime</artifactId>
            <version>4.13.2</version>
        </dependency>

        <dependency>
            <groupId>log4j</groupId>
            <artifactId>log4j</artifactId>
            <version>1.2.17</version>
        </dependency>

        <dependency>
            <groupId>commons-lang</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.6</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>6.1.0-M1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>6.1.0-M1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>6.1.0-M1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.jacoco</groupId>
            <artifactId>org.jacoco.agent</artifactId>
            <classifier>runtime</classifier>
            <version>0.8.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>enforce-maven</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>3.6.3</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>21</release>
                    <proc>full</proc>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.9.0</version>
                <executions>
                    <execution>
                        <id>build-classpath</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>build-classpath</goal>
                        </goals>
                        <configuration>
                            <outputFile>target/generated-sources/classpath.txt</outputFile>
                            <outputProperty>maven.compile.classpath</outputProperty>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <configuration>
                    <outputDirectory>${jacoco.report_dir}/</outputDirectory>
                    <excludes>
                        <exclude>fr/ensimag/deca/tools/DecacInternalError.class</exclude>
                        <exclude>fr/ensimag/deca/ima/pseudocode/IMAInternalError.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>default-instrument</id>
                        <goals>
                            <goal>instrument</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-restore-instrumented-classes</id>
                        <goals>
                            <goal>restore-instrumented-classes</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>default-check</id>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.20</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>basic-lex</id>
                        <configuration>
                            <executable>./src/test/script/basic-lex.sh</executable>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>basic-synt</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/basic-synt.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>unit-test-symbol</id>
                        <configuration>
                            <mainClass>fr.ensimag.deca.tools.ManualTestSymbol</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>basic-context</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/basic-context.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>basic-gencode</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/basic-gencode.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>basic-decac</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/basic-lex.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>common-tests</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/common-tests.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>syntax-valid-helloworld</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-valid-helloworld.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-invalid-helloworld</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-invalid-helloworld.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-valid-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-valid-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-invalid-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-invalid-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-valid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-valid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-invalid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-invalid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-valid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-valid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>syntax-invalid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/syntax-invalid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>

                    <execution>
                        <id>context-valid-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-valid-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>context-invalid-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-invalid-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>context-valid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-valid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>context-invalid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-invalid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>context-valid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-valid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>context-invalid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/context-invalid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>

                    <execution>
                        <id>codegen-valid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-valid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-invalid-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-invalid-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-valid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-valid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-invalid-objet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-invalid-objet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-perf-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-perf-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-perf-sansobjet</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-perf-sansobjet.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-interactive</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-interactive.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>
                    <execution>
                        <id>codegen-valid-provided</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments><argument>./src/test/script/codegen-valid-provided.sh</argument></arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals><goal>exec</goal></goals>
                    </execution>


                    <execution>
                        <id>jacoco-report</id>
                        <configuration>
                            <executable>/bin/sh</executable>
                            <arguments>
                                <argument>./src/test/script/jacoco-report.sh</argument>
                            </arguments>
                        </configuration>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-maven-plugin</artifactId>
                <version>4.13.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>antlr4</goal>
                        </goals>
                        <configuration>
                            <visitor>false</visitor>
                            <listener>false</listener>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                </configuration>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>make-jar</id>
                        <configuration>
                            <descriptorRefs>
                                <descriptorRef>jar-with-dependencies</descriptorRef>
                            </descriptorRefs>
                            <archive>
                                <manifest>
                                    <mainClass>fr.ensimag.deca.DecacMain</mainClass>
                                </manifest>
                            </archive>
                        </configuration>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>make-dir</id>
                        <configuration>
                            <appendAssemblyId>false</appendAssemblyId>
                            <finalName>package</finalName>
                            <descriptors>
                                <descriptor>src/main/assembly/unix.xml</descriptor>
                            </descriptors>
                        </configuration>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.9.0</version>
                </plugin>

                <plugin>
                    <groupId>org.eclipse.m2e</groupId>
                    <artifactId>lifecycle-mapping</artifactId>
                    <version>1.0.0</version>
                    <configuration>
                        <lifecycleMappingMetadata>
                            <pluginExecutions>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>
                                            org.apache.maven.plugins
                                        </groupId>
                                        <artifactId>
                                            maven-clean-plugin
                                        </artifactId>
                                        <versionRange>[2.5,)</versionRange>
                                        <goals>
                                            <goal>clean</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                                <pluginExecution>
                                    <pluginExecutionFilter>
                                        <groupId>org.apache.maven.plugins</groupId>
                                        <artifactId>maven-dependency-plugin</artifactId>
                                        <versionRange>[2.5.1,)</versionRange>
                                        <goals>
                                            <goal>build-classpath</goal>
                                        </goals>
                                    </pluginExecutionFilter>
                                    <action>
                                        <ignore></ignore>
                                    </action>
                                </pluginExecution>
                            </pluginExecutions>
                        </lifecycleMappingMetadata>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>4.0.0-M16</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <reporting>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>3.6.0</version>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>3.28.0</version>
                <configuration>
                    <targetJdk>${compileSource}</targetJdk>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>findbugs-maven-plugin</artifactId>
                <version>3.0.5</version>
                <configuration>
                    <excludeFilterFile>src/main/config/findbugs-exclude.xml</excludeFilterFile>
                    <effort>Min</effort>
                    <threshold>Exp</threshold>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <minmemory>128m</minmemory>
                    <maxmemory>1g</maxmemory>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <configuration>
                                <additionalparam>-Xdoclint:none</additionalparam>
                            </configuration>
                        </execution>
                    </executions>
                    <tags>
                        <tag>
                            <name>date</name>
                            <placement>tp</placement>
                            <head>Creation date:</head>
                        </tag>
                    </tags>
                </configuration>
            </plugin>
        </plugins>
    </reporting>

    <organization>
        <name>Ensimag</name>
        <url>http://ensimag.grenoble-inp.fr/</url>
    </organization>

    <licenses>
        <license>
            <name>Private project. Distribution is not allowed.</name>
        </license>
    </licenses>


// Description:
//    Appel d'une methode non declaree.
//
// Resultats:
//    Erreur contextuelle attendue.
//
// Historique:
//    cree le 13/01/2026

class Calculator {
    int add(int a, int b) {
        return a + b;
    }
}

{
    Calculator calc;
    calc = new Calculator();
    println(calc.undefinedMethod(5));
}

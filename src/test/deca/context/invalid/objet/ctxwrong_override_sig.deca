// Description:
//    Passe 2 - Override d'une methode avec signature differente.
//
// Resultats:
//    Erreur contextuelle attendue (signature d'override incompatible).
//
// Historique:
//    cree le 13/01/2026

class Base {
    int getValue() {
        return 50;
    }
}

class Derived extends Base {
    int getValue(int x) {
        return 100;
    }
}

{
    println(1);
}

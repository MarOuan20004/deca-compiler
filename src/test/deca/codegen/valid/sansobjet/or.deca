// Description:
//    Operateur logique OR (||).
//
// Resultats:
//    Affiche 1 puis 1 puis 0.
//
// Historique:
//    cree le 11/01/2026

{
    int a;
    int b;

    a = 1;
    b = 0;

    if (a == 1 || b == 1) {
        println(1);
    } else {
        println(0);
    }

    if (a == 0 || b == 0) {
        println(1);
    } else {
        println(0);
    }

    a = 0;
    if (a == 1 || b == 1) {
        println(1);
    } else {
        println(0);
    }
}

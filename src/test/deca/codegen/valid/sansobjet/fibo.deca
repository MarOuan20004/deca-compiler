// Description:
//    Fibonacci iteratif (F7 = 13).
//
// Resultats:
//    Affiche 13.
//
// Historique:
//    cree le 10/01/2026

{
    int n;
    int a;
    int b;
    int t;
    int i;

    n = 7;
    a = 0;
    b = 1;
    t = 0;
    i = 1;

    while (i < n) {
        t = b;
        b = a + b;
        a = t;
        i = i + 1;
    }

    println(b);
}


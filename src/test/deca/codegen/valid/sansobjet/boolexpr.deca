// Description:
//    Expressions booleennes imbriquees avec && et ||.
//
// Resultats:
//    Affiche 1 puis 0 puis 1.
//
// Historique:
//    cree le 09/01/2026

{
    int a;
    int b;
    int c;

    a = 5;
    b = 3;
    c = 7;

    if ((a > b) && (b < c)) {
        println(1);
    } else {
        println(0);
    }

    if ((a > b) && (b > c)) {
        println(1);
    } else {
        println(0);
    }

    if ((a > b) || (b > c)) {
        println(1);
    } else {
        println(0);
    }
}

// Description:
//    Comparaisons int et float.
//
// Resultats:
//    Affiche 1 puis 0.
//
// Historique:
//    cree le 06/01/2026

{
    int x;
    float y;

    x = 3;
    y = 3.0;

    if (x <= y && x == 3) {
        println(1);
    } else {
        println(0);
    }

    y = y + 1.5;

    if (x > y) {
        println(1);
    } else {
        println(0);
    }
}


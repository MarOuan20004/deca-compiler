// Description:
//    Operateur NOT unaire (!).
//
// Resultats:
//    Affiche 0 puis 1 puis 1.
//
// Historique:
//    cree le 11/01/2026

{
    int a;

    a = 1;
    if (!true) {
        println(1);
    } else {
        println(0);
    }

    if (!(a == 1)) {
        println(1);
    } else {
        println(0);
    }

    if (!(a == 2)) {
        println(1);
    } else {
        println(0);
    }
}

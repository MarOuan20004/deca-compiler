// Description:
//    Melange print/println avec chaine, entier, et echappements.
//
// Resultats:
//    Affiche 'Val=' puis 'Val=7' puis Ligne1/Ligne2 et Tab-Stop.
//
// Historique:
//    cree le 11/01/2026

{
    int v;
    v = 7;
    print("Val=");
    println();
    print("Val=");
    println(v);
    print("Ligne1\nLigne2");
    println();
    print("Tab\tStop");
    println();
}


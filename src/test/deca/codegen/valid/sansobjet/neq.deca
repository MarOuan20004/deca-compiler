// Description:
//    Operateur d'inegalite (!=).
//
// Resultats:
//    Affiche 1 puis 0.
//
// Historique:
//    cree le 11/01/2026

{
    int x;
    int y;

    x = 5;
    y = 3;

    if (x != y) {
        println(1);
    } else {
        println(0);
    }

    y = 5;

    if (x != y) {
        println(1);
    } else {
        println(0);
    }
}

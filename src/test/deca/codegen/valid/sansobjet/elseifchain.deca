// Description:
//    Chaines de else if.
//
// Resultats:
//    Affiche 2 puis 3.
//
// Historique:
//    cree le 10/01/2026

{
    int n;

    n = 2;
    if (n == 1) {
        println(1);
    } else if (n == 2) {
        println(2);
    } else if (n == 3) {
        println(3);
    } else {
        println(0);
    }

    n = 3;
    if (n == 1) {
        println(1);
    } else if (n == 2) {
        println(2);
    } else if (n == 3) {
        println(3);
    } else {
        println(0);
    }
}

// Description:
//    Appels de methodes avec arguments varies (plusieurs parametres de types differents).
//
// Resultats:
//    Affiche 65 (50 + 15.0 convertis en int).
//
// Historique:
//    cree le 13/01/2026

class Calculator {
    int addInt(int a, int b) {
        return a + b;
    }
    
    int addFloat(int a, float b) {
        return a + (int)b;
    }
}

{
    Calculator calc;
    calc = new Calculator();
    println(calc.addInt(30, 20));
    println(calc.addFloat(50, 15.0));
}

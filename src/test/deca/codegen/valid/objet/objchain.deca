// Description:
//    Chainahe de selection sur plusieurs niveaux (obj1.obj2.field).
//
// Resultats:
//    Affiche 99.
//
// Historique:
//    cree le 13/01/2026

class Inner {
    int value;
}

class Outer {
    Inner inner;
}

{
    Outer outer;
    Inner in;
    outer = new Outer();
    in = new Inner();
    in.value = 99;
    outer.inner = in;
    println(outer.inner.value);
}

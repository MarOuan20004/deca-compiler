// Description:
//      Test interactif de lecture et d'affichage d'un flottant.
//      Simule la lecture d'une valeur par un capteur de température.
//
// Resultats:
//      Affiche la temperature saisie suivie de l'unité.
//
// Historique:
//    cree le 18/01/2026

{
    float currentTemperature;

    println("Veuillez entrer la temperature actuelle (float) :");
    currentTemperature = readFloat();

    println("Temperature enregistree : ", currentTemperature, " degres Celsius.");
}
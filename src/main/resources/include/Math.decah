    float determinant(float[][] M_orig) {
        int n = getNLines(M_orig);
        float[][] M;
        float det = 1.0;
        float sign = 1.0;
        float facteur = 0.0;
        float val = 0.0;
        float temp = 0.0;
        int k = 0;
        int i = 0;
        int j = 0;
        int pivot = -1;
        boolean found = false;

        if (n != getNCols(M_orig)) {
            println("Erreur : la matrice doit etre carree");
            return 0.0;
        }

        M = this.copieFloat(M_orig);

        while (k < n) {
            // Recherche du pivot
            if (getElem(M, k, k) == 0.0) {
                pivot = -1;
                i = k + 1;
                found = false;
                while (i < n && !found) {
                    if (getElem(M, i, k) != 0.0) {
                        pivot = i;
                        found = true;
                    }
                    i = i + 1;
                }
                
                if (pivot == -1) {
                    return 0.0;
                }
                
                // Échange des lignes M[k] et M[pivot]
                j = 0;
                while (j < n) {
                    temp = getElem(M, k, j);
                    setElem(M, k, j, getElem(M, pivot, j));
                    setElem(M, pivot, j, temp);
                    j = j + 1;
                }
                sign = -sign;
            }

            // Élimination
            i = k + 1;
            while (i < n) {
                facteur = getElem(M, i, k) / getElem(M, k, k);
                j = k;
                while (j < n) {
                    val = getElem(M, i, j) - facteur * getElem(M, k, j);
                    setElem(M, i, j, val);
                    j = j + 1;
                }
                i = i + 1;
            }
            k = k + 1;
        }

        // Produit de la diagonale
        i = 0;
        while (i < n) {
            det = det * getElem(M, i, i);
            i = i + 1;
        }

        return sign * det;
    }

    float[][] inverse(float[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        float[][] M;
        float[][] Inv;
        float pivot = 0.0;
        float factor = 0.0;
        int i = 0;
        int j = 0;
        int k = 0;
        int i2 = 0;
        int j2 = 0;

        // Vérification que la matrice est carrée
        if (n != m) {
            println("Erreur : la matrice doit etre carree");
            return new float[0][0];
        }

        // Initialisation de la matrice augmentée [A | I]
        M = new float[n][2 * n];
        i = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                setElem(M, i, j, getElem(A, i, j));
                if (i == j) {
                    setElem(M, i, j + n, 1.0);
                } else {
                    setElem(M, i, j + n, 0.0);
                }
                j = j + 1;
            }
            i = i + 1;
        }

        // Élimination de Gauss-Jordan
        k = 0;
        while (k < n) {
            pivot = getElem(M, k, k);
            if (pivot == 0.0) {
                println("Erreur : la matrice n est pas inversible");
                return new float[0][0];
            }

            // Division de la ligne du pivot par sa valeur
            j = 0;
            while (j < 2 * n) {
                setElem(M, k, j, getElem(M, k, j) / pivot);
                j = j + 1;
            }

            // Soustraction des multiples de la ligne du pivot des autres lignes
            i2 = 0;
            while (i2 < n) {
                if (i2 != k) {
                    factor = getElem(M, i2, k);
                    j = 0;
                    while (j < 2 * n) {
                        setElem(M, i2, j, getElem(M, i2, j) - factor * getElem(M, k, j));
                        j = j + 1;
                    }
                }
                i2 = i2 + 1;
            }
            k = k + 1;
        }

        // Récupération de la partie droite de la matrice augmentée
        Inv = new float[n][n];
        i = 0;
        while (i < n) {
            j2 = 0;
            while (j2 < n) {
                setElem(Inv, i, j2, getElem(M, i, j2 + n));
                j2 = j2 + 1;
            }
            i = i + 1;
        }
        return Inv;
    }

    void printMatriceFloat(float[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j = 0;
        while (i < n) {
            print("[");
            j = 0;
            while (j < m) {
                print(getElem(A, i, j));
                if (j < m - 1) {
                    print(", ");
                }
                j = j + 1;
            }
            println("]");
            i = i + 1;
        }
    }
}


    float traceFloat(float[][] A) {
        int n = getNLines(A);
        float sum = 0.0;
        int i = 0;
        float val = 0.0;

        if (n != getNCols(A)) {
            println("Erreur : la trace n est possible que pour une matrice carree");
            return 0.0;
        }

        while (i < n) {
            val = getElem(A, i, i);
            sum = sum + val;
            i = i + 1;
        }
        return sum;
    }

    boolean estNilpotenteFloat(float[][] A, int k) {
        int n = getNLines(A);
        int m = getNCols(A);
        float[][] power;
        int exp = 0;
        int i = 0;
        int j = 0;
        float val = 0.0;
        float diff = 0.0;
        float e = 0.00001;
        if (!(n == m)) {
            return false;
        }
        power = this.uniteFloat(n);
        while (exp < k) {
            power = this.produitFloat(power, A);
            exp = exp + 1;
        }
        i = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                val = getElem(power, i, j);
                diff = val;
                if (diff < 0) {
                    diff = -diff;
                }
                if (diff > e) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }


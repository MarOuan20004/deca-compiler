class Math {

    int[][] unite(int n) {
        int[][] M = new int[n][n];
        int i = 0;
        int j;
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i == j) {
                    setElem(M, i, j, 1);
                } else {
                    setElem(M, i, j, 0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    int[][] matriceNulle(int n, int m) {
        int[][] M = new int[n][m];
        int i = 0;
        int j;
        while (i < n) {
            j = 0;
            while (j < m) {
                setElem(M, i, j, 0);
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    int[][] matriceConstante(int n, int m, int v) {
        int[][] M = new int[n][m];
        int i = 0;
        int j;
        while (i < n) {
            j = 0;
            while (j < m) {
                setElem(M, i, j, v);
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    int[][] matriceUn(int n, int m) {
        int[][] M = new int[n][m];
        int i = 0;
        int j;
        while (i < n) {
            j = 0;
            while (j < m) {
                setElem(M, i, j, 1);
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    int[][] transposee(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] T = new int[m][n];
        int i = 0;
        int j;
        int val;
        while (i < n) {
            j = 0;
            while (j < m) {
                val = getElem(A, i, j);
                setElem(T, j, i, val);
                j = j + 1;
            }
            i = i + 1;
        }
        return T;
    }

    int[][] addition(int[][] A, int[][] B) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] C = new int[n][m];
        int i = 0;
        int j;
        int valA;
        int valB;
        while (i < n) {
            j = 0;
            while (j < m) {
                valA = getElem(A, i, j);
                valB = getElem(B, i, j);
                setElem(C, i, j, valA + valB);
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    int[][] scalaire(int[][] A, int v) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] C = new int[n][m];
        int i = 0;
        int j;
        int val;
        while (i < n) {
            j = 0;
            while (j < m) {
                val = getElem(A, i, j);
                setElem(C, i, j, val * v);
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    int[][] produit(int[][] A, int[][] B) {
        int n = getNLines(A);
        int m = getNCols(B);
        int p = getNCols(A);
        int[][] C = new int[n][m];
        int i = 0;
        int j;
        int k;
        int sum;
        int valA;
        int valB;
        while (i < n) {
            j = 0;
            while (j < m) {
                sum = 0;
                k = 0;
                while (k < p) {
                    valA = getElem(A, i, k);
                    valB = getElem(B, k, j);
                    sum = sum + valA * valB;
                    k = k + 1;
                }
                setElem(C, i, j, sum);
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    int[][] matriceDiagonale(int[] diag) {
        int n = getNLines(diag);
        int[][] M = new int[n][n];
        int i = 0;
        int j;
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i == j) {
                    setElem(M, i, j, getElem(diag, i, 0));
                } else {
                    setElem(M, i, j, 0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    boolean egale(int[][] A, int[][] B) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j;
        int valA;
        int valB;
        if (n != getNLines(B)) {
            return false;
        }
        if (m != getNCols(B)) {
            return false;
        }
        while (i < n) {
            j = 0;
            while (j < m) {
                valA = getElem(A, i, j);
                valB = getElem(B, i, j);
                if (!(valA == valB)) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }

    boolean estSymetrique(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j;
        int valAij;
        int valAji;
        if (!(n == m)) {
            return false;
        }
        while (i < n) {
            j = 0;
            while (j < n) {
                valAij = getElem(A, i, j);
                valAji = getElem(A, j, i);
                if (!(valAij == valAji)) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }

    boolean estAntisymetrique(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j;
        int valAij;
        int valAji;
        if (!(n == m)) {
            return false;
        }
        while (i < n) {
            j = 0;
            while (j < n) {
                valAij = getElem(A, i, j);
                valAji = getElem(A, j, i);
                if (!(valAij == -valAji)) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }

    int trace(int[][] A) {
        int n = getNLines(A);
        int sum = 0;
        int i = 0;
        int val;
        while (i < n) {
            val = getElem(A, i, i);
            sum = sum + val;
            i = i + 1;
        }
        return sum;
    }

    boolean estNilpotente(int[][] A, int k) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] power;
        int i = 0;
        int j;
        int exp;
        int val;
        if (!(n == m)) {
            return false;
        }
        power = this.unite(n);
        exp = 0;
        while (exp < k) {
            power = this.produit(power, A);
            exp = exp + 1;
        }
        i = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                val = getElem(power, i, j);
                if (!(val == 0)) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }

    int[][] triangulaireSup(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] T;
        int i = 0;
        int j = 0;
        if (n != m) {
            println("Erreur : la matrice doit etre carree");
            return new int[0][0];
        }
        T = new int[n][n];
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i <= j) {
                    setElem(T, i, j, getElem(A, i, j));
                } else {
                    setElem(T, i, j, 0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return T;
    }

    int[][] triangulaireInf(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] T;
        int i = 0;
        int j = 0;
        if (n != m) {
            println("Erreur : la matrice doit etre carree");
            return new int[0][0];
        }
        T = new int[n][n];
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i >= j) {
                    setElem(T, i, j, getElem(A, i, j));
                } else {
                    setElem(T, i, j, 0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return T;
    }

    int[][] copie(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] C = new int[n][m];
        int i = 0;
        int j = 0;
        while (i < n) {
            j = 0;
            while (j < m) {
                setElem(C, i, j, getElem(A, i, j));
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    void printMatrice(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j = 0;
        while (i < n) {
            print("[");
            j = 0;
            while (j < m) {
                print(getElem(A, i, j));
                if (j < m - 1) {
                    print(", ");
                }
                j = j + 1;
            }
            println("]");
            i = i + 1;
        }
    }


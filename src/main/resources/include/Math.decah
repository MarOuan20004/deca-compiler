    float[][] produitFloat(float[][] A, float[][] B) {
        int n = getNLines(A);
        int m = getNCols(B);
        int p = getNCols(A);
        float[][] C;
        int i = 0;
        int j = 0;
        int k = 0;
        float sum = 0.0;
        float valA = 0.0;
        float valB = 0.0;

        if (p != getNLines(B)) {
            println("Erreur : le produit matriciel n est pas possible");
            return new float[0][0];
        }

        C = new float[n][m];
        while (i < n) {
            j = 0;
            while (j < m) {
                sum = 0.0;
                k = 0;
                while (k < p) {
                    valA = getElem(A, i, k);
                    valB = getElem(B, k, j);
                    sum = sum + valA * valB;
                    k = k + 1;
                }
                setElem(C, i, j, sum);
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    float[][] matriceDiagonaleFloat(float[] diag) {
        int n = getNLines(diag);
        float[][] M = new float[n][n];
        int i = 0;
        int j = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i == j) {
                    setElem(M, i, j, getElem(diag, i, 0));
                } else {
                    setElem(M, i, j, 0.0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }

    boolean egaleFloat(float[][] A, float[][] B) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j = 0;
        float valA = 0.0;
        float valB = 0.0;
        float diff = 0.0;
        float e = 0.00001;
        if (n != getNLines(B)) {
            return false;
        }
        if (m != getNCols(B)) {
            return false;
        }
        while (i < n) {
            j = 0;
            while (j < m) {
                valA = getElem(A, i, j);
                valB = getElem(B, i, j);
                diff = valA - valB;
                if (diff < 0) {
                    diff = -diff;
                }
                if (diff > e) {
                    return false;
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return true;
    }


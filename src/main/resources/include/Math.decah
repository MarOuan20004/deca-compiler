    int[][] copie(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int[][] C = new int[n][m];
        int i = 0;
        int j = 0;
        while (i < n) {
            j = 0;
            while (j < m) {
                setElem(C, i, j, getElem(A, i, j));
                j = j + 1;
            }
            i = i + 1;
        }
        return C;
    }

    void printMatrice(int[][] A) {
        int n = getNLines(A);
        int m = getNCols(A);
        int i = 0;
        int j = 0;
        while (i < n) {
            print("[");
            j = 0;
            while (j < m) {
                print(getElem(A, i, j));
                if (j < m - 1) {
                    print(", ");
                }
                j = j + 1;
            }
            println("]");
            i = i + 1;
        }
    }

    float abs(float f) {
        if (f < 0.0) {
            return -f;
        }
        return f;
    }

    float sqrt(float f) {
        float x = f;
        float y = 1.0;
        float e = 0.0001;
        if (f < 0.0) {
            println("Erreur : sqrt d un nombre negatif");
            return 0.0;
        }
        if (f == 0.0) {
            return 0.0;
        }
        while (this.abs(x - y) > e) {
            x = (x + y) / 2.0;
            y = f / x;
        }
        return x;
    }

    float ulp(float f) {
        float x = this.abs(f);
        float res = 1.0;
        if (f == 0.0) {
            // Very small value for 0.0
            return 1.4e-45; 
        }
        
        if (x >= 1.0) {
            while (res * 2.0 <= x) {
                res = res * 2.0;
            }
        } else {
            while (res > x) {
                res = res / 2.0;
            }
        }
        // res is now the largest power of 2 <= |f|
        // ulp is res / 2^23
        return res / 8388608.0; 
    }

    float[][] uniteFloat(int n) {
        float[][] M = new float[n][n];
        int i = 0;
        int j = 0;
        while (i < n) {
            j = 0;
            while (j < n) {
                if (i == j) {
                    setElem(M, i, j, 1.0);
                } else {
                    setElem(M, i, j, 0.0);
                }
                j = j + 1;
            }
            i = i + 1;
        }
        return M;
    }


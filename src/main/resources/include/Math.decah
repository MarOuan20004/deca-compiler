// Library for class Math of Deca, coded in Deca

int[][] _unite(int n) {
    int[][] M = new int[n][n];
    int i = 0;
    int j;
    while (i < n) {
        j = 0;
        while (j < n) {
            if (i == j) {
                setElem(M, i, j, 1);
            } else {
                setElem(M, i, j, 0);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

int[][] _matriceNulle(int n, int m) {
    int[][] M = new int[n][m];
    int i = 0;
    int j;
    while (i < n) {
        j = 0;
        while (j < m) {
            setElem(M, i, j, 0);
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

int[][] _matriceConstante(int n, int m, int v) {
    int[][] M = new int[n][m];
    int i = 0;
    int j;
    while (i < n) {
        j = 0;
        while (j < m) {
            setElem(M, i, j, v);
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

int[][] _matriceUn(int n, int m) {
    int[][] M = new int[n][m];
    int i = 0;
    int j;
    while (i < n) {
        j = 0;
        while (j < m) {
            setElem(M, i, j, 1);
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

int[][] _transposee(int[][] A) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] T = new int[m][n];
    int i = 0;
    int j;
    int val;
    while (i < n) {
        j = 0;
        while (j < m) {
            val = getElem(A, i, j);
            setElem(T, j, i, val);
            j = j + 1;
        }
        i = i + 1;
    }
    return T;
}

int[][] _addition(int[][] A, int[][] B) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] C = new int[n][m];
    int i = 0;
    int j;
    int valA;
    int valB;
    while (i < n) {
        j = 0;
        while (j < m) {
            valA = getElem(A, i, j);
            valB = getElem(B, i, j);
            setElem(C, i, j, valA + valB);
            j = j + 1;
        }
        i = i + 1;
    }
    return C;
}

int[][] _scalaire(int[][] A, int v) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] C = new int[n][m];
    int i = 0;
    int j;
    int val;
    while (i < n) {
        j = 0;
        while (j < m) {
            val = getElem(A, i, j);
            setElem(C, i, j, val * v);
            j = j + 1;
        }
        i = i + 1;
    }
    return C;
}

int[][] _produit(int[][] A, int[][] B) {
    int n = getNLines(A);
    int m = getNCols(B);
    int p = getNCols(A);
    int[][] C = new int[n][m];
    int i = 0;
    int j;
    int k;
    int sum;
    int valA;
    int valB;
    while (i < n) {
        j = 0;
        while (j < m) {
            sum = 0;
            k = 0;
            while (k < p) {
                valA = getElem(A, i, k);
                valB = getElem(B, k, j);
                sum = sum + valA * valB;
                k = k + 1;
            }
            setElem(C, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return C;
}

int[][] _matriceDiagonale(int[] diag) {
    int n = getNLines(diag);
    int[][] M = new int[n][n];
    int i = 0;
    int j;
    while (i < n) {
        j = 0;
        while (j < n) {
            if (i == j) {
                setElem(M, i, j, getElem(diag, i, 0));
            } else {
                setElem(M, i, j, 0);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return M;
}

boolean _egale(int[][] A, int[][] B) {
    int n = getNLines(A);
    int m = getNCols(A);
    int i = 0;
    int j;
    int valA;
    int valB;
    if (n != getNLines(B)) {
        return false;
    }
    if (m != getNCols(B)) {
        return false;
    }
    while (i < n) {
        j = 0;
        while (j < m) {
            valA = getElem(A, i, j);
            valB = getElem(B, i, j);
            if (!(valA == valB)) {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

boolean _estSymetrique(int[][] A) {
    int n = getNLines(A);
    int m = getNCols(A);
    int i = 0;
    int j;
    int valAij;
    int valAji;
    if (!(n == m)) {
        return false;
    }
    while (i < n) {
        j = 0;
        while (j < n) {
            valAij = getElem(A, i, j);
            valAji = getElem(A, j, i);
            if (!(valAij == valAji)) {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

boolean _estAntisymetrique(int[][] A) {
    int n = getNLines(A);
    int m = getNCols(A);
    int i = 0;
    int j;
    int valAij;
    int valAji;
    if (!(n == m)) {
        return false;
    }
    while (i < n) {
        j = 0;
        while (j < n) {
            valAij = getElem(A, i, j);
            valAji = getElem(A, j, i);
            if (!(valAij == -valAji)) {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

int _trace(int[][] A) {
    int n = getNLines(A);
    int sum = 0;
    int i = 0;
    int val;
    while (i < n) {
        val = getElem(A, i, i);
        sum = sum + val;
        i = i + 1;
    }
    return sum;
}

boolean _estNilpotente(int[][] A, int k) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] power;
    int i = 0;
    int j;
    int exp;
    int val;
    if (!(n == m)) {
        return false;
    }
    power = _unite(n);
    exp = 0;
    while (exp < k) {
        power = _produit(power, A);
        exp = exp + 1;
    }
    i = 0;
    while (i < n) {
        j = 0;
        while (j < n) {
            val = getElem(power, i, j);
            if (!(val == 0)) {
                return false;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return true;
}

int[][] _triangulaireSup(int[][] A) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] T;
    int i = 0;
    int j = 0;
    if (n != m) {
        println("Erreur : la matrice doit etre carree");
        return new int[0][0];
    }
    T = new int[n][n];
    while (i < n) {
        j = 0;
        while (j < n) {
            if (i <= j) {
                setElem(T, i, j, getElem(A, i, j));
            } else {
                setElem(T, i, j, 0);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return T;
}

int[][] _triangulaireInf(int[][] A) {
    int n = getNLines(A);
    int m = getNCols(A);
    int[][] T;
    int i = 0;
    int j = 0;
    if (n != m) {
        println("Erreur : la matrice doit etre carree");
        return new int[0][0];
    }
    T = new int[n][n];
    while (i < n) {
        j = 0;
        while (j < n) {
            if (i >= j) {
                setElem(T, i, j, getElem(A, i, j));
            } else {
                setElem(T, i, j, 0);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return T;
}


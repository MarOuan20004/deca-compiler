// Description:
//    Test basique de l'objet.
//    Vérifie l'instanciation, l'appel de méthode et la manipulation de champs.
//
// Resultats:
//    Compteur = 15

class Compteur {
    int x = 0;

    void incr(int val) {
        // Test: accès au champ 'x' (this.x) et au paramètre 'val'
        x = x + val;
    }

    int getX() {
        return x;
    }
}

{
    Compteur c;
    
    // 1. Allocation (Tas) + Appel init.Compteur
    c = new Compteur();

    // 2. Appels de méthode (BSR)
    c.incr(10);
    c.incr(5);

    print("Compteur = ");
    // 3. Récupération de résultat
    println(c.getX());
}